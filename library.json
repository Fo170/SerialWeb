{
  "name": "SerialWeb",
  "version": "1.1.1",
  "description": "Moniteur série WebSocket pour ESP8266/ESP32 : chaque log Serial est dupliqué sur USB + un buffer circulaire (backlog) + broadcast WebSocket, avec commandes bidirectionnelles",
  "keywords": ["serial", "websocket", "monitor", "debug", "log", "async", "esp8266", "esp32"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fo170/SerialWeb.git"
  },
  "authors": [
    {
      "name": "Olivier FOURNET",
      "email": "olivier.fournet@free.fr",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Fo170/SerialWeb",
  "frameworks": "arduino",
  "platforms": [
    "espressif8266",
    "espressif32"
  ],
  "headers": "SerialWeb.h",
  "examples": [
    {
      "name": "Basic",
      "base": "examples/basic",
      "files": ["basic.ino"]
    }
  ],
  "dependencies": {
    "esp32async/ESPAsyncWebServer": "^3.7.3"
  }
}
